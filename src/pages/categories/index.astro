---
import { Icon } from "astro-icon/components";
import CategoryBlocks from "@/components/widget/CategoryBlocks.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryTree } from "@/utils/content-utils";

const categories = await getCategoryTree();
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
---

<MainGridLayout title={i18n(I18nKey.categories)}>
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.categories)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allCategories)} · {totalPosts} {i18n(I18nKey.postsCount)}
        </p>
        <p class="text-30 text-sm mt-2">
            顶层是数学、物理、计算机、文学。要新增块，在
            <code class="text-(--primary)">src/config/taxonomyConfig.ts</code>
            里加一层，或写文章时把 category 写成
            <code class="text-(--primary)">数学/新专题</code>。
        </p>
    </div>

    {
        categories.length > 0 ? (
            <CategoryBlocks nodes={categories} />
        ) : (
            <div class="card-base px-8 py-12 text-center">
                <Icon
                    name="material-symbols:folder-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }
</MainGridLayout>
